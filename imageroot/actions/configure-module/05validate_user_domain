#!/usr/bin/env python3
import json
import os
import sys
import agent
from agent.ldapproxy import Ldapproxy

request = json.load(sys.stdin)
domain = request.get("user_domain", os.environ.get("LDAP_USER_DOMAIN", ""))
if domain and domain not in Ldapproxy().get_domains_list():
    agent.set_status("validation-failed")
    json.dump([{"field": "user_domain", "parameter": "user_domain",
                "error": "user_domain_unavailable"}], sys.stdout)
    sys.exit(2)
