#
# Read configuration
#

import os
import sys
import json
import agent
import agent.tasks
from agent.ldapproxy import Ldapproxy

# Prepare return variable
config = {}

# Read current configuration from the environment file
config["host"] = os.getenv("TRAEFIK_HOST","")
config["http2https"] = os.getenv("TRAEFIK_HTTP2HTTPS") == "True"
config["lets_encrypt"] = os.getenv("TRAEFIK_LETS_ENCRYPT") == "True"
config["user_domain"] = os.getenv("LDAP_USER_DOMAIN", "")
config["ldap_email_attribute"] = os.getenv("LDAP_EMAIL_ATTRIBUTE", "mail")
config["ldap_sync_enabled"] = os.getenv("LDAP_SYNC_PROFILES", "false") == "true"
config["available_user_domains"] = Ldapproxy().get_domains_list()
config["ip_allowlist"] = json.loads(os.getenv("TRAEFIK_IP_ALLOWLIST", '["127.0.0.1/32"]'))
if config["host"]:
    route = agent.tasks.run(agent_id=agent.resolve_agent_id('traefik@node'), action='get-route',
                            data={'instance': os.environ['MODULE_ID']},
                            extra={'isNotificationHidden': True})
    if route['exit_code'] == 0 and route.get('output'):
        config["ip_allowlist"] = route['output'].get('ip_allowlist', [])

# Dump the configuration to stdout
json.dump(config, fp=sys.stdout)
