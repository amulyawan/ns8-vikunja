#!/usr/bin/env python3
"""Disable existing local accounts when the administrator selects directory-only auth."""
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time

if not os.environ.get("LDAP_USER_DOMAIN"):
    raise SystemExit(0)

# Read identity/status only, never password hashes. Change status through the
# supported Vikunja CLI rather than writing application database records.
query = "SELECT COALESCE(json_agg(json_build_object('id',id,'username',username,'status',status)), '[]'::json) FROM users WHERE issuer='local' AND status=0"
command = ["podman", "exec", "postgresql-app", "psql", "-U", "postgres", "-d", "vikunja", "-Atc", query]
for attempt in range(30):
    result = subprocess.run(command, capture_output=True, text=True, timeout=10)
    if result.returncode == 0:
        break
    time.sleep(1)
else:
    raise RuntimeError("Directory-only policy cannot verify local account status")

users = json.loads(result.stdout)
if users:
    backup = Path("local-users-before-directory.json")
    prior = json.loads(backup.read_text()) if backup.exists() else {}
    for user in users:
        prior.setdefault(str(user["id"]), user)
    os.umask(0o077)
    with tempfile.NamedTemporaryFile("w", dir=".", delete=False) as stream:
        json.dump(prior, stream)
        temporary = stream.name
    os.replace(temporary, backup)
    for user in users:
        subprocess.run(["podman", "exec", "vikunja-app", "/app/vikunja/vikunja",
                        "user", "change-status", str(user["id"]), "--disable"],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
