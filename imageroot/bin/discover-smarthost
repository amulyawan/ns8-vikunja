import agent

# Connect the local Redis replica. This is necessary to consistently start
# the service if the leader node is not reachable:
smtp = agent.get_smarthost_settings(agent.redis_connect(use_replica=True))
agent.write_envfile("smarthost.env", {
    "VIKUNJA_MAILER_ENABLED": str(bool(smtp["enabled"])).lower(),
    "VIKUNJA_MAILER_HOST": smtp["host"],
    "VIKUNJA_MAILER_PORT": smtp["port"],
    "VIKUNJA_MAILER_USERNAME": smtp["username"],
    "VIKUNJA_MAILER_PASSWORD": smtp["password"],
    "VIKUNJA_MAILER_FORCESSL": str(smtp["encrypt_smtp"] == "tls").lower(),
    "VIKUNJA_MAILER_SKIPTLSVERIFY": str(not smtp["tls_verify"]).lower(),
})
