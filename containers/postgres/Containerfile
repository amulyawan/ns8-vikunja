# Rebuild the unchanged gosu 1.20 source with a patched Go toolchain.
FROM docker.io/library/golang:1.27.4-alpine3.24@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS helper
RUN apk add --no-cache git
WORKDIR /src
RUN git clone --depth 1 --branch 1.20 https://github.com/tianon/gosu.git . \
    && test "$(git rev-parse HEAD)" = 29b939aa5bd4dc588af765b8248f6e39150d2565 \
    && CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=512MiB go build -mod=readonly -trimpath -o /out/gosu .

FROM docker.io/library/postgres:15.20-alpine3.24@sha256:e18480a22d6e48f4d816a6696769b1ec09ac73a824c5649e49c7d8b684913f3d
# Preserve PostgreSQL, entrypoint, initdb and volume paths; patch base packages.
RUN apk upgrade --no-cache
COPY --from=helper /out/gosu /usr/local/bin/gosu
COPY --from=helper /src/LICENSE /usr/local/share/licenses/gosu/LICENSE
RUN gosu nobody true && postgres --version
LABEL org.opencontainers.image.licenses="PostgreSQL AND Apache-2.0"
